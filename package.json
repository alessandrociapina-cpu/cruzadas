{
  "name": "cruzadas",
  "version": "0.1.0",
  "description": "Aplicativo PWA que lê a foto de uma palavra cruzada e a transforma numa grade preenchível no celular.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "testar": "node --test test/*.test.mjs",
    "testar:fluxo": "node test/visual/fluxo.mjs capturas",
    "diagnostico": "node test/visual/detect-photo.mjs test/fixtures/cruzada-jornal.jpg diagnostico.png 0",
    "servir": "node test/visual/servidor.mjs"
  },
  "devDependencies": {
    "playwright": "^1.56.0"
  }
}
